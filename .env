# Live address of the API in backend/, for example https://api.your-domain.com/api.
# Set it before building for production. During npm start, .env.development points it at the local backend instead.
# Everything about an event (name, media, links, Wi-Fi, questions) is in backend/events.json.
REACT_APP_API_URL=http://127.0.0.1:8000/api
