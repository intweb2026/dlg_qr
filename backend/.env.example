# One reference command above each variable, run them inside backend/ in Git Bash or Linux. Those with $NAME read the value from .env first, set -a; . ./.env; set +a
# Find a free port, node -e "require('net').createServer().listen(0,function(){console.log(this.address().port);this.close()})"
PORT=8000
# Show the mode the API will use, True or False, node -e "console.log(require('./src/config').debug)"
DEBUG=True
# Count the proxies in front of the API, 1 for Coolify, 0 when reached directly, 2 with Cloudflare too, show the number the API will use, node -e "console.log(require('./src/config').trustProxy)"
TRUST_PROXY=1
# Test a host name, curl -s -o /dev/null -w "%{http_code}\n" -H "Host: api.your-domain.com" localhost:8000/api/health
ALLOWED_HOSTS=localhost,127.0.0.1
# Make a token with, node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPORT_ACCESS_TOKEN=
# Switch the CRM post on or off, true or false, check it on the Logbook page after a lucky draw spin
SEND_FEEDBACK_SUBMISSION_TO_CRM=true
# Check the webhook host can be reached, any status but 000 means it can, curl -s -o /dev/null -w "%{http_code}\n" -X OPTIONS "$CRM_WEBHOOK_URL"
CRM_WEBHOOK_URL=https://www.app.iq-hub.com/api/webhooks/feedback-form/
# The key is given by the CRM team, it is sent in the X-CRM-API-KEY header, never put it in the address
CRM_API_KEY=
# Check the delegates answer, curl -s -o /dev/null -w "%{http_code}\n" -H "X-DATA-API-KEY: $CRM_DATA_API_KEY" "$CRM_DATA_API_URL?event_code=ABC%20-%20XY"
CRM_DATA_API_URL=https://www.app.iq-hub.com/api/data/registered_delegates/
# The key is given by the CRM team, check it with the line above, 200 works and 401 or 403 means a wrong key
CRM_DATA_API_KEY=
# Test the site address is allowed, curl -s -i -H "Origin: http://localhost:3000" localhost:8000/api/health | grep -i access-control-allow-origin
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Check the key, curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | head -c 200
GEMINI_API_KEY=
# List the models the key can use, curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | grep '"name"'
GEMINI_MODEL=gemini-3.5-flash-lite
# The address the models are called on, check it answers, curl -s -o /dev/null -w "%{http_code}\n" "$GEMINI_API_URL?key=$GEMINI_API_KEY"
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Who gets the feedback report, a comma separated list, check the first address has a mail server, node -e "require('dns').resolveMx(process.argv[1],(e,r)=>console.log(e?e.code:r))" iq-hub.com
FEEDBACK_REPORT_TO=linq-web@iq-hub.com
# Test the mail login with the five SMTP values below, node -r dotenv/config -e "require('nodemailer').createTransport({host:process.env.SMTP_HOST,port:+process.env.SMTP_PORT,secure:process.env.SMTP_SECURE==='true',auth:{user:process.env.SMTP_USER,pass:process.env.SMTP_PASS}}).verify().then(()=>console.log('SMTP login works'),e=>console.log(e.message))"
SMTP_HOST=
# Check the port is open, node -e "require('net').connect(+process.argv[2],process.argv[1]).on('connect',()=>{console.log('open');process.exit()}).on('error',e=>{console.log(e.code);process.exit()})" "$SMTP_HOST" "$SMTP_PORT"
SMTP_PORT=587
# true for port 465, false for 587, the same test as SMTP_HOST shows which one the server wants
SMTP_SECURE=false
# The mail login name, usually the full address, test it with the SMTP_HOST line
SMTP_USER=
# The mail password or app password, test it with the SMTP_HOST line
SMTP_PASS=
# The sender address, defaults to SMTP_USER, send a test mail, node -r dotenv/config -e "require('nodemailer').createTransport({host:process.env.SMTP_HOST,port:+process.env.SMTP_PORT,secure:process.env.SMTP_SECURE==='true',auth:{user:process.env.SMTP_USER,pass:process.env.SMTP_PASS}}).sendMail({from:process.env.MAIL_FROM||process.env.SMTP_USER,to:process.env.FEEDBACK_REPORT_TO,subject:'Test',text:'Test'}).then(()=>console.log('sent'),e=>console.log(e.message))"
MAIL_FROM=

# Optional, left out of a normal setup.
# Turn databases.json into the one line DATABASES_JSON needs, node -e "console.log(JSON.stringify(require('./databases.json')))"
# DATABASES_JSON=
# Check the login file reads, node -e "JSON.parse(require('fs').readFileSync(process.env.DATABASES_FILE||'databases.json'));console.log('ok')"
# DATABASES_FILE=
# Check the events file reads, node -e "JSON.parse(require('fs').readFileSync(process.env.EVENTS_FILE||'events.json'));console.log('ok')"
# EVENTS_FILE=
# Make the uploads folder, and check it can be written to, mkdir -p /data/uploads && touch /data/uploads/.w && rm /data/uploads/.w && echo writable
# UPLOADS_DIR=/data/uploads
# Make an admin entry with a strong password, node -e "console.log('admin1:'+require('crypto').randomBytes(12).toString('base64url')+':Full Name')"
# DEFAULT_ADMINS=
