# Server. Local values are shown, a production host sets its own in the environment, the code has no localhost defaults.
# PORT is the port the API listens on inside its container or host, pick any free one. The proxy (Coolify) is what the
# internet reaches on 80 and 443, so this port is not exposed. Set the same number as the exposed port in Coolify.
PORT=8000
# Use False on a live server, True shows error details.
DEBUG=True
# How many proxies sit in front of the API, so the visitor's real address is used for the sign in lockout and the rate
# limit. 1 for Coolify's proxy, 0 when the API is reached directly, 2 when another proxy such as Cloudflare is in front too.
TRUST_PROXY=1
# Host names this API answers on, for example api.your-domain.com. * allows any. Required in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database logins, one entry per database. Either keep them in databases.json (see databases.example.json), or set
# DATABASES_JSON to the same JSON on one line, for a host where only the environment can be set. It wins over the file.
# DATABASES_JSON={"feedback_aiu26":{"host":"db-host","port":3306,"user":"app","password":"secret"}}

# Bearer token the CRM sends to read interested-attendees and feedback-responses, one value for every event.
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it those routes answer 503. To rotate, list the new value after the old one, comma separated, then drop the old one.
EXPORT_ACCESS_TOKEN=

# When the host presses spin, the feedback responses are posted here with the key in the X-CRM-API-KEY header.
# SEND_FEEDBACK_SUBMISSION_TO_CRM switches the post on (true) or off (false, the default when unset).
# It is also skipped when the URL or key is empty.
SEND_FEEDBACK_SUBMISSION_TO_CRM=true
CRM_WEBHOOK_URL=https://www.app.iq-hub.com/api/webhooks/feedback-form/
CRM_API_KEY=

# The registered delegates are read from the CRM, GET <CRM_DATA_API_URL>?event_code=<event_code> with the key in the
# X-DATA-API-KEY header. Each event's CRM code is "event_code" in events.json. Without a key, or for an event with
# no event_code, the attendee list is not synced. The first visitor to the site fetches the list once and it is saved;
# after that it is fetched again only when an admin presses Sync now on the Attendees page.
CRM_DATA_API_URL=https://www.app.iq-hub.com/api/data/registered_delegates/
CRM_DATA_API_KEY=

# CORS, the address of the site that calls this API, comma separated. Required in production, for example
# https://events.your-domain.com. The local React server is shown here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini writes the suggested testimonial on the feedback form's first question. Without a key the form
# skips the suggestion and keeps the attendee's own words. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The Gemini model tried first for the suggestion. If it is busy, the backend tries its backup models.
GEMINI_MODEL=gemini-3.5-flash-lite
# The Gemini API address the models are called on.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Folder for the images and videos uploaded on the admin Event Details page, served at /api/uploads/.
# Defaults to backend/uploads. On a host whose disk is wiped on redeploy, point it at a persistent volume.
# UPLOADS_DIR=

# The feedback submissions report: the day after an event's last day, at 12:00 AM where the event is held, every
# submission is put in one PDF and emailed to FEEDBACK_REPORT_TO (comma separated). It is sent once per event, and
# only within 7 days of that time; older ones are sent with Send now on the admin Feedback submissions page.
# Without SMTP_HOST nothing is emailed, the PDF can still be downloaded from that page.
# FEEDBACK_REPORT_TO has no default in the code, it must be set here or in the server's environment.
FEEDBACK_REPORT_TO=linq-web@iq-hub.com
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender address, defaults to SMTP_USER. Some mail servers only accept their own address here.
MAIL_FROM=

# Admin accounts made in every new event database by npm run migrate, as username:password:Full Name entries,
# comma separated. Existing accounts are left as they are. Without it, the default accounts in src/config.js are made. npm run migrate reads this list, there is no other copy.
# Use strong passwords on the live server.
# DEFAULT_ADMINS=benny:change-me:Benny,maxwell:change-me:Maxwell,ramon:change-me:Ramon
