# Server
PORT=8000
DEBUG=True
# Host names this API answers on, for example api.your-domain.com. * allows any.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database logins are in databases.json, one entry per database, see databases.example.json

# Bearer token the CRM sends to read interested-attendees and feedback-responses, one value for every event.
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it those routes answer 503. To rotate, list the new value after the old one, comma separated, then drop the old one.
EXPORT_ACCESS_TOKEN=

# CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini writes the suggested testimonial on the feedback form's first question. Without a key the form
# skips the suggestion and keeps the attendee's own words. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, the Gemini model tried first for the suggestion. If it is busy, the backend tries others.
# GEMINI_MODEL=gemini-3.5-flash-lite
