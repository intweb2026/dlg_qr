# Server
PORT=8000
DEBUG=True
# Host names this API answers on, for example api.your-domain.com. * allows any.
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
DB_NAME=feedback_db
DB_USER=root
DB_PASSWORD=your_mysql_password
